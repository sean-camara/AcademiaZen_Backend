{
  "name": "academiazen-backend",
  "version": "1.1.0",
  "description": "AcademiaZen API Server - AI-powered study assistant",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "generate-vapid": "node scripts/generate-vapid.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "node --check server.js && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "firebase-admin": "14.2.0",
    "helmet": "8.3.0",
    "mongoose": "8.24.1",
    "web-push": "3.6.7"
  },
  "keywords": [
    "push-notifications",
    "pwa",
    "web-push",
    "vapid"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  }
}
