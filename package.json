{
  "name": "academiazen-backend",
  "version": "1.1.0",
  "description": "AcademiaZen API Server - AI-powered study assistant",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.js",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "generate-vapid": "node scripts/generate-vapid.js",
    "test": "npm run build && vitest",
    "test:run": "npm run build && vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run build && vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@aws-sdk/s3-request-presigner": "3.1090.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "firebase-admin": "14.2.0",
    "helmet": "8.3.0",
    "mongoose": "8.24.1",
    "web-push": "3.6.7"
  },
  "keywords": [
    "push-notifications",
    "pwa",
    "web-push",
    "vapid"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
